NODE_ENV=development
PORT=8002
DB_CONNECT_STRING=postgres://pms_dev:pms12345@127.0.0.1:5432/hotel_pms_dev

# Access token signing secret (required in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Comma-separated allowed origins for the frontend, e.g. http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Set INIT=1 to create the root account on startup if none exists.
# Root is only for initial setup: sign in as root and create the owner's super_admin account.
INIT=0
ROOT_USERNAME=root
ROOT_PASSWORD=
